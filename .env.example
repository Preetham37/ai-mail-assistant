# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Discord Webhook URL for Daily Push Notifications
# (Get this from Discord: Channel Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Optional: Multi-Account Gmail Ingestion (JSON string or base64-encoded JSON)
# If not set, falls back to local token.json / credentials.json or GMAIL_TOKEN / GMAIL_CREDENTIALS
# GMAIL_ACCOUNTS_JSON=[{"account_id": "acc_personal", "account_label": "PERSONAL", "account_color_hex": "#8B5CF6", "token": {...}}, {"account_id": "acc_work", "account_label": "WORK", "account_color_hex": "#3B82F6", "token": {...}}]

